<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.9">
  <world name="default">
    <!--
      Gazebo's default Physics, UserCommands and SceneBroadcaster systems are
      intentionally used, matching the working warehouse world. Sensors and
      IMU systems are supplied by BCR Bot's gz.xacro and are not duplicated.
    -->
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.45 0.45 0.48 1</ambient>
      <background>0.68 0.78 0.90 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <light name="flat_field_sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 40 0 0 0</pose>
      <diffuse>0.9 0.88 0.82 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.45 0.25 -0.86</direction>
    </light>

    <model name="flat_ground_100m">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="flat_ground_100m_link">
        <collision name="flat_ground_100m_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="flat_ground_100m_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.32 0.36 0.31 1</ambient>
            <diffuse>0.42 0.48 0.40 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

